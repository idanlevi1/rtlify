{
  "name": "rtlify-ai",
  "version": "0.4.0",
  "description": "Zero-config RTL rules and linter for AI code editors (Claude Code, Cursor, Windsurf, Cline, Copilot, Gemini, Codex) — Hebrew, Arabic, Persian",
  "type": "module",
  "bin": {
    "rtlify-ai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node -e \"require('fs').copyFileSync('src/rules.md','dist/rules.md')\"",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/scanner.test.mjs test/cli.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "rtl",
    "rtl-support",
    "right-to-left",
    "i18n",
    "localization",
    "bidi",
    "bidirectional",
    "hebrew",
    "arabic",
    "persian",
    "farsi",
    "urdu",
    "react",
    "react-native",
    "nextjs",
    "tailwind",
    "tailwindcss",
    "css-logical-properties",
    "cursor",
    "windsurf",
    "claude-code",
    "copilot",
    "ai-rules",
    "ai-coding",
    "linter",
    "frontend",
    "gemini",
    "codex",
    "vue",
    "svelte",
    "css"
  ],
  "license": "MIT",
  "author": "Idan Levi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idanlevi1/rtlify.git"
  },
  "bugs": {
    "url": "https://github.com/idanlevi1/rtlify/issues"
  },
  "homepage": "https://github.com/idanlevi1/rtlify#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
